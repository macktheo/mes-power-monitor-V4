# Salin ke .env.local (lokal) dan isi di Vercel > Project > Settings > Environment Variables
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
DASHBOARD_PASSWORD=ganti-password-dashboard
SESSION_SECRET=gantjang-lain
# Tarif listrik per kWh (Rupiah). Cek tarif golongan Anda yang berlaku saat ini!
TARIF_PER_KWH=1444.70
# Batas daya (W) untuk menolak lonjakan register energi PZEM yang tidak masuk akal (glitch). Naikkan bila beban Anda lebih besar.
ENERGY_MAX_W=2000

# --- MQTT (dibuat otomatis oleh "npm run setup") ---
MQTT_ESP_HOST=192.168.0.106
MQTT_ESP_PORT=1883
MQTT_USE_TLS=0
MQTT_WS_URL=ws://192.168.0.106:9001
MQTT_URL=mqtt://localhost:1883
MQTT_ESP_USER=esp32
MQTT_ESP_PASS=
MQTT_DASH_USER=dashboard
MQTT_DASH_PASS=
MQTT_BRIDGE_USER=bridge
MQTT_BRIDGE_PASS=
