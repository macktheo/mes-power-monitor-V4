// Salin file ini menjadi "secrets.h" lalu isi (atau jalankan: npm run setup). JANGAN commit secrets.h.
#pragma once

#define WIFI_SSID      "NAMA_WIFI"
#define WIFI_PASSWORD  "PASSWORD_WIFI"

// Alamat broker MQTT yang bisa dijangkau ESP32 (IP laptop/Raspberry Pi, atau host broker cloud)
#define MQTT_HOST      "192.168.0.106"
#define MQTT_PORT      1883
#define MQTT_USER      "esp32"
#define MQTT_PASS      "ganti-password-mqtt"

// 0 = TCP biasa (broker lokal, port 1883)
// 1 = TLS (broker cloud, biasanya port 8883)
#define MQTT_USE_TLS   0

// Hanya berlaku jika MQTT_USE_TLS 1:
// 1 = tidak memvalidasi sertifikat (uji coba saja), 0 = validasi dengan ROOT_CA di bawah
#define USE_INSECURE_TLS 1
